# ─────────────────────────────────────────────────────────────
# Arca — variables de entorno
# Copia este archivo a .env y rellena los valores.
# ─────────────────────────────────────────────────────────────

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Postgres (local en dev, Neon en producción)
# Neon: usa la cadena "pooled" para la web y la "direct" para migraciones/worker.
DATABASE_URL="postgres://arca:arca@localhost:5432/arca"
DATABASE_URL_DIRECT="postgres://arca:arca@localhost:5432/arca"

# Better Auth
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# Owner (solo lo usa el script de seed)
OWNER_EMAIL="owner@arca.local"
OWNER_NAME="Owner"
OWNER_PASSWORD="cambia-esta-password"

# Storage S3-compatible (MinIO en dev, Backblaze B2 en producción)
# Deja S3_ENDPOINT/S3_KEY/S3_SECRET vacíos para trabajar solo con la UI.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="arca-media"
S3_KEY=""
S3_SECRET=""
S3_FORCE_PATH_STYLE="true"

# GitHub Actions (dispatch del worker)
# Token fine-grained con Contents: read/write sobre el repo.
GITHUB_REPO=""
GITHUB_DISPATCH_TOKEN=""

# Cron / sweep
CRON_SECRET=""

# Límites
MAX_FILE_BYTES="1073741824"
STORAGE_QUOTA_BYTES="10737418240"

# Worker (Go)
WORKER_MAX_ATTEMPTS="3"
WORKER_LEASE_SECONDS="1800"
WORKER_POLL_SECONDS="10"
WORKER_JOB_TIMEOUT_SECONDS="1500"
WORKER_TMP="/tmp"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
PDFTOPPM_PATH="pdftoppm"
